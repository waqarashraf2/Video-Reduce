# Default directory index
DirectoryIndex index.html index.php

# Options
Options -Indexes +FollowSymLinks -MultiViews

# Default Charset
AddDefaultCharset UTF-8

# ==============================================================================
# 1. OPTIMAL BROWSER CACHING (mod_expires)
# ==============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML Pages: Cache for 1 hour with revalidation
    ExpiresByType text/html "access plus 1 hour"

    # Data / JSON / Manifest
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType application/manifest+json "access plus 1 week"

    # Hashed JS & CSS (Next.js static assets have unique hashes, safe to cache 1 year)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Media & Images: 1 month cache
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # Web Fonts: 1 year cache
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ==============================================================================
# 2. HTTP CACHE-CONTROL & SECURITY HEADERS (mod_headers)
# ==============================================================================
<IfModule mod_headers.c>
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Embedder-Policy "credentialless"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # 1. HTML Pages: Stale-While-Revalidate
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
    </FilesMatch>

    # 2. Hashed Next.js static assets (_next/static JS/CSS): 1 year immutable
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # 3. Images & Media Assets: 30 days cache with stale-while-revalidate
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico|woff2|woff)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
    </FilesMatch>

    # 4. Service Worker (sw.js) & version check: Always check with server
    <FilesMatch "(sw\.js|version\.json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ==============================================================================
# 3. REWRITE RULES & ROUTING (mod_rewrite)
# ==============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Stop processing if this is already an internal sub-request (prevents loops & 500 errors)
    RewriteCond %{ENV:REDIRECT_STATUS} !^$
    RewriteRule ^ - [L]

    # Force www to non-www redirect (canonical domain)
    RewriteCond %{HTTP_HOST} ^www\.videoreduce\.com [NC]
    RewriteRule ^(.*)$ https://videoreduce.com/$1 [R=301,L]

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Consolidate legacy /en/ routes to canonical URLs
    RewriteRule ^en/(.*)$ https://videoreduce.com/$1 [R=301,L]
    RewriteRule ^en/?$ https://videoreduce.com/ [R=301,L]

    # Force 301 Canonical: Strip trailing slashes from any subpage URLs
    # (e.g. https://videoreduce.com/tools/video-compressor/ -> https://videoreduce.com/tools/video-compressor)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \s+/(.+?)/+[?\s]
    RewriteRule ^ https://videoreduce.com/%1 [R=301,L]

    # 1. Serve existing physical files directly (CSS, JS, images, favicon, robots.txt, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 2. If a folder with index.html exists, serve it
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*?)/?$ /$1/index.html [L]

    # 3. Clean URL rewrite: /tools/video-compressor or /articles -> .html
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*?)/?$ /$1.html [L]

    # 4. Fallback to 404.html if resource does not exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /404.html [L]
</IfModule>

# Fallback Error Document
ErrorDocument 404 /404.html
