# Set default directory index
DirectoryIndex index.html index.php

# Options: Disable directory listing and follow symlinks
Options -Indexes +FollowSymLinks

# Prevent Apache mod_dir from forcing trailing slashes on folders
DirectorySlash Off

<IfModule mod_headers.c>
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Embedder-Policy "require-corp"
    # Enable HSTS (Strict-Transport-Security) for 1 year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # CRITICAL CACHE CONTROL:
    # 1. HTML files: Never cache aggressively so mobile & desktop visitors always get latest code immediately!
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # 2. Hashed static assets (_next/static JS/CSS): Safe to cache long term because filenames have content hashes
    <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|svg|woff2|woff)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Force UTF-8 charset
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force www to non-www redirect (canonical domain)
    RewriteCond %{HTTP_HOST} ^www\.videoreduce\.com [NC]
    RewriteRule ^(.*)$ https://videoreduce.com/$1 [R=301,L]

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 1. 301 Redirect: Remove trailing slash from all URLs for SEO canonicalization (e.g. /articles/ -> /articles)
    # Excludes root '/' because '.+' requires at least one character before the slash
    RewriteCond %{REQUEST_URI} ^(.+)/+$
    RewriteRule ^ %1 [R=301,L,QSA]

    # 2. Serve existing files directly (CSS, JS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Clean URL rewrite: /about -> /about.html or /articles -> /articles.html
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # 4. Clean URL rewrite for folders with index.html: /folder -> /folder/index.html
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    # 5. If requesting a directory that has neither an index.html nor a matching .html, show 404 instead of 403 Forbidden
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html !-f
    RewriteRule ^ 404.html [L]

    # 6. Fallback to 404.html for any other non-existent resource
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.html [L]
</IfModule>
