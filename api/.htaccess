<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Security: Block sensitive files from direct web access
<FilesMatch "^\.env|\.git|composer\.(json|lock)|package\.json|phpunit\.xml">
    Order allow,deny
    Deny from all
</FilesMatch>
