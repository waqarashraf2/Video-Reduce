APP_NAME="VideoReduce API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Frontend URL allowed for CORS requests
FRONTEND_URL=http://localhost:3000

# Admin email where contact form submissions will be delivered
ADMIN_NOTIFICATION_EMAIL=your-email@example.com

# Database Configuration (Defaults to sqlite, can be switched to mysql for production)
DB_CONNECTION=sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=videoreduce_db
DB_USERNAME=root
DB_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Mail Configuration (Configure your SMTP credentials here)
# For local testing without SMTP server, use MAIL_MAILER=log (emails written to storage/logs/laravel.log)
# For production (Gmail, Hostinger, Mailgun, Brevo, SendGrid), use MAIL_MAILER=smtp
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@videoreduce.com"
MAIL_FROM_NAME="VideoReduce Notifications"
